{
  "manifest_version": 3,
  "name": "MacVolume Tabs",
  "version": "0.7.0",
  "minimum_chrome_version": "116",
  "description": "Per-tab volume and playback in MacVolume, with previous, next and shuffle for supported YouTube players.",
  "permissions": ["tabs", "scripting", "nativeMessaging", "storage", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["media-controller.js", "transport-controller.js", "page-controller.js"],
      "run_at": "document_start", "world": "MAIN", "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-bridge.js"], "run_at": "document_start", "all_frames": true
    }
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "MacVolume Tabs",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "incognito": "not_allowed"
}
